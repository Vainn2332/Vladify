#this is an example of .env file. copy it to .env file and fill it(or just use it as an example of filling your user secrets)

#do NOT expose it on github(by default it is excluded in gitignore)

#ConnectionString to connect to the database. Make sure to change the password and other parameters as needed.
ConnectionStrings__ApplicationDbContext=Server=localhost,1433;Database=your_db_name;User Id=sa;Password=Your_password123;TrustServerCertificate=True

#Auth0
Auth0__Domain=your-tenant.eu.auth0.com
Auth0__TokenUrl=https://your-tenant.eu.auth0.com/oauth/token

# Public (SPA) client — used for the API login flow.
Auth0__PublicClient__ClientId=your-public-client-id
Auth0__PublicClient__ClientSecret=your-public-client-secret

#audience of the JWT(example:https://Vladify/musicAPI)
Auth0__PublicClient__Audience=https://api.vladify

# Machine-to-machine client — used for server-to-Auth0 calls(delete user & etc)
Auth0__M2MClient__ClientId=your-m2m-client-id
Auth0__M2MClient__ClientSecret=your-m2m-client-secret
Auth0__M2MClient__Audience=https://your-tenant.eu.auth0.com/api/v2/

# API keys 
# Shared secret expected on the Auth0 -> DB sync webhook.
ApiKeys__Auth0SyncInDb=change-me-to-a-strong-secret

#  RabbitMQ (used by the API via MassTransit) 
#ServerHost is the host name only, WITHOUT port or scheme (e.g. localhost), not localhost:5672
RabbitMqOptions__ServerHost=localhost
RabbitMqOptions__Username=guest
RabbitMqOptions__Password=guest

# gRPC clients 
# URL of the external moderation service.
GrpcClients__ModerationServiceUrl=https://localhost:7000

#  CORS (optional) 
# Defaults are set in appsettings.json. Override the allowed frontend origins:
# Cors__AllowedOrigins__0=http://localhost:5173
# Cors__AllowedOrigins__1=https://localhost:5173
